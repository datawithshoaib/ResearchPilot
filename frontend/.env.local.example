# URL of the ResearchPilot FastAPI backend (no trailing slash).
# Local: http://localhost:8000 — Vercel: your Render URL, e.g. https://researchpilot-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project (Project Settings > API). The anon / publishable key is safe in the browser;
# never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
