# Copy to backend/.env for local development. On Render, set these in the dashboard.

# Required: chat model (Groq) and web search (Tavily)
GROQ_API_KEY="your_groq_api_key_here"
TAVILY_API_KEY="your_tavily_api_key_here"

# Required: Supabase (Project Settings > API) for sign-in and per-user report history.
SUPABASE_URL="https://your-project-ref.supabase.co"
# Server-only secret; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
# Only for projects still on the legacy HS256 JWT secret (Project Settings > JWT Keys).
# Projects on the newer signing keys are verified through the public JWKS automatically.
# SUPABASE_JWT_SECRET="your_legacy_jwt_secret"

# Optional model overrides
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_TEMPERATURE=0
TAVILY_MAX_RESULTS=3

# development | production (production hides /docs and /openapi.json)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Browser origins allowed to call the API. Add your Vercel domain in production,
# and optionally a regex that matches Vercel preview deployments.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# CORS_ORIGIN_REGEX="https://researchpilot-[a-z0-9-]+\.vercel\.app"

# Guard rails: concurrent running jobs, and how long finished jobs are kept.
MAX_ACTIVE_JOBS=4
JOB_TTL_MINUTES=180

# Optional: LangSmith tracing
# LANGSMITH_API_KEY="your_langsmith_api_key_here"
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT="researchpilot"
